        "transactions_shape_ck": {
          "name": "transactions_shape_ck",
          "value": "CASE \"transactions\".\"type\"\n        WHEN 'INCOME'  THEN \"transactions\".\"source_asset_id\" IS NULL\n                            AND \"transactions\".\"destination_asset_id\" IS NOT NULL\n        WHEN 'EXPENSE' THEN \"transactions\".\"source_asset_id\" IS NOT NULL\n                            AND \"transactions\".\"destination_asset_id\" IS NULL\n        WHEN 'TRANSFER' THEN \"transactions\".\"source_asset_id\" IS NOT NULL\n                             AND \"transactions\".\"destination_asset_id\" IS NOT NULL\n                             AND \"transactions\".\"source_asset_id\" <> \"transactions\".\"destination_asset_id\"\n      END"
        },
        "transactions_transfer_no_category_ck": {
          "name": "transactions_transfer_no_category_ck",
          "value": "\"transactions\".\"type\" <> 'TRANSFER' OR \"transactions\".\"category_id\" IS NULL"
        },
        "transactions_status_voided_ck": {
          "name": "transactions_status_voided_ck",
          "value": "(\"transactions\".\"status\" = 'ACTIVE' AND \"transactions\".\"voided_at\" IS NULL)\n       OR (\"transactions\".\"status\" = 'VOIDED' AND \"transactions\".\"voided_at\" IS NOT NULL)"
        },
        "transactions_no_self_replace_ck": {
          "name": "transactions_no_self_replace_ck",
          "value": "\"transactions\".\"replaces_transaction_id\" <> \"transactions\".\"id\""
        }
